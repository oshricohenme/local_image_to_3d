{
  "backend": "sdcpp",
  "assets": {
    "model": {
      "repo": "Comfy-Org/Wan_2.1_ComfyUI_repackaged",
      "revision": "123acf1cc74bccbb9bfff8ac1ee72edc08c2341d",
      "gated": false,
      "files": [
        "split_files/diffusion_models/wan2.1_t2v_1.3B_fp16.safetensors",
        "split_files/text_encoders/umt5_xxl_fp16.safetensors",
        "split_files/vae/wan_2.1_vae.safetensors"
      ]
    }
  },
  "prepare": [],
  "required": [
    "{repo}/build/bin/sd-cli"
  ],
  "tasks": {
    "text_to_video": {
      "commands": [
        [
          "{repo}/build/bin/sd-cli",
          "--backend",
          "metal",
          "-M",
          "vid_gen",
          "--diffusion-model",
          "{model}/split_files/diffusion_models/wan2.1_t2v_1.3B_fp16.safetensors",
          "--vae",
          "{model}/split_files/vae/wan_2.1_vae.safetensors",
          "--t5xxl",
          "{model}/split_files/text_encoders/umt5_xxl_fp16.safetensors",
          "--prompt",
          "{prompt}",
          "--width",
          "{width}",
          "--height",
          "{height}",
          "--steps",
          "{steps}",
          "--cfg-scale",
          "{guidance}",
          "--seed",
          "{seed}",
          "--sampling-method",
          "euler",
          "--rng",
          "cpu",
          "--output",
          "{out}/result.avi",
          "--vae-tiling",
          "--flow-shift",
          "3",
          "--video-frames",
          "{frames}",
          "--fps",
          "16"
        ],
        [
          "ffmpeg",
          "-v",
          "error",
          "-y",
          "-i",
          "{out}/result.avi",
          "-c:v",
          "libx264",
          "-pix_fmt",
          "yuv420p",
          "-c:a",
          "aac",
          "-movflags",
          "+faststart",
          "{out}/result.mp4"
        ]
      ],
      "outputs": [
        "result.mp4"
      ]
    }
  }
}
