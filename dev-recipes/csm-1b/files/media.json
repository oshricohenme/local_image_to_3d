{
  "backend": "audio",
  "assets": {
    "model": {
      "repo": "mlx-community/csm-1b",
      "revision": "5bf5ec118cf45fecc7b51198fd9f1a20a5aab65a",
      "gated": false
    },
    "codec": {
      "repo": "kyutai/moshiko-pytorch-bf16",
      "revision": "2bfc9ae6e89079a5cc7ed2a68436010d91a3d289",
      "gated": false,
      "files": [
        "tokenizer-e351c8d8-checkpoint125.safetensors"
      ]
    },
    "tokenizer": {
      "repo": "unsloth/Llama-3.2-1B",
      "revision": "9535bd9b1d1dea6acafbdc4813b728796aeb28da",
      "gated": false,
      "files": [
        "special_tokens_map.json",
        "tokenizer.json",
        "tokenizer_config.json"
      ]
    }
  },
  "prepare": [
    [
      "{python}",
      "-m",
      "lift_media.apis",
      "prepare-tts",
      "--model",
      "{model}",
      "--kind",
      ""
    ]
  ],
  "required": [
    "{model}/config.json"
  ],
  "tasks": {
    "voice_clone": {
      "commands": [
        [
          "{python}",
          "-m",
          "mlx_audio.tts.generate",
          "--model",
          "{model}",
          "--text",
          "{text}",
          "--join_audio",
          "--output_path",
          "{out}",
          "--file_prefix",
          "result",
          "--ref_audio",
          "{reference}",
          "--ref_text",
          "{transcript}"
        ]
      ],
      "outputs": [
        "result*.wav"
      ]
    }
  }
}
