{
  "backend": "audio",
  "assets": {
    "model": {
      "repo": "mlx-community/Soprano-1.1-80M-bf16",
      "revision": "745350c27f356c3910eebcb49e29760dcf6a643c",
      "gated": false
    }
  },
  "prepare": [
    [
      "{python}",
      "-m",
      "lift_media.apis",
      "prepare-tts",
      "--model",
      "{model}",
      "--kind",
      ""
    ]
  ],
  "required": [
    "{model}/config.json"
  ],
  "tasks": {
    "text_to_speech": {
      "commands": [
        [
          "{python}",
          "-m",
          "mlx_audio.tts.generate",
          "--model",
          "{model}",
          "--text",
          "{text}",
          "--join_audio",
          "--output_path",
          "{out}",
          "--file_prefix",
          "result"
        ]
      ],
      "outputs": [
        "result*.wav"
      ]
    }
  }
}
