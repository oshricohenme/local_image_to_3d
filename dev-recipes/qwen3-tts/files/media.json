{
  "backend": "audio",
  "assets": {
    "model": {
      "repo": "mlx-community/Qwen3-TTS-12Hz-0.6B-CustomVoice-8bit",
      "revision": "049ef77fe8816b536193c0c25f9a214d17921282",
      "gated": false
    }
  },
  "prepare": [
    [
      "{python}",
      "-m",
      "lift_media.apis",
      "prepare-tts",
      "--model",
      "{model}",
      "--kind",
      ""
    ]
  ],
  "required": [
    "{model}/config.json"
  ],
  "tasks": {
    "text_to_speech": {
      "commands": [
        [
          "{python}",
          "-m",
          "mlx_audio.tts.generate",
          "--model",
          "{model}",
          "--text",
          "{text}",
          "--join_audio",
          "--output_path",
          "{out}",
          "--file_prefix",
          "result",
          "--voice",
          "{voice}"
        ]
      ],
      "outputs": [
        "result*.wav"
      ]
    }
  }
}
