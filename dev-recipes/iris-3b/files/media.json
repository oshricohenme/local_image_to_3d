{
  "backend": "sdcpp",
  "assets": {
    "model": {
      "repo": "speridlabs/iris-3b",
      "revision": "adc05b909fb05d4276d26aae5a52b36406b2ef26",
      "gated": false,
      "files": [
        "model.safetensors"
      ]
    },
    "encoder": {
      "repo": "Qwen/Qwen3-VL-4B-Instruct-GGUF",
      "revision": "1cd86afb9a95c410a6038ab3b40d8b578c892266",
      "gated": false,
      "files": [
        "Qwen3VL-4B-Instruct-Q4_K_M.gguf"
      ]
    }
  },
  "prepare": [],
  "required": [
    "{repo}/build/bin/sd-cli"
  ],
  "tasks": {
    "text_to_image": {
      "commands": [
        [
          "{repo}/build/bin/sd-cli",
          "--backend",
          "metal",
          "--diffusion-model",
          "{model}/model.safetensors",
          "--llm",
          "{encoder}/Qwen3VL-4B-Instruct-Q4_K_M.gguf",
          "--prompt",
          "{prompt}",
          "--width",
          "{width}",
          "--height",
          "{height}",
          "--steps",
          "{steps}",
          "--cfg-scale",
          "{guidance}",
          "--seed",
          "{seed}",
          "--sampling-method",
          "euler",
          "--rng",
          "cpu",
          "--output",
          "{out}/result.png"
        ]
      ],
      "outputs": [
        "result.png"
      ]
    }
  }
}
