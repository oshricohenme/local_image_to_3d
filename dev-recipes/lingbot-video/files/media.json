{
  "backend": "sdcpp",
  "assets": {
    "model": {
      "repo": "robbyant/lingbot-video-dense-1.3b",
      "revision": "f9789a7d9b4772a47aba62d4eb5282ddefd1da21",
      "gated": false,
      "files": [
        "transformer/diffusion_pytorch_model.safetensors"
      ]
    },
    "vae": {
      "repo": "Comfy-Org/Wan_2.1_ComfyUI_repackaged",
      "revision": "123acf1cc74bccbb9bfff8ac1ee72edc08c2341d",
      "gated": false,
      "files": [
        "split_files/vae/wan_2.1_vae.safetensors"
      ]
    },
    "encoder": {
      "repo": "Qwen/Qwen3-VL-4B-Instruct-GGUF",
      "revision": "1cd86afb9a95c410a6038ab3b40d8b578c892266",
      "gated": false,
      "files": [
        "Qwen3VL-4B-Instruct-Q4_K_M.gguf"
      ]
    }
  },
  "prepare": [],
  "required": [
    "{repo}/build/bin/sd-cli"
  ],
  "tasks": {
    "text_to_video": {
      "commands": [
        [
          "{repo}/build/bin/sd-cli",
          "--backend",
          "metal",
          "-M",
          "vid_gen",
          "--diffusion-model",
          "{model}/transformer/diffusion_pytorch_model.safetensors",
          "--vae",
          "{vae}/split_files/vae/wan_2.1_vae.safetensors",
          "--llm",
          "{encoder}/Qwen3VL-4B-Instruct-Q4_K_M.gguf",
          "--prompt",
          "{prompt}",
          "--width",
          "{width}",
          "--height",
          "{height}",
          "--steps",
          "{steps}",
          "--cfg-scale",
          "{guidance}",
          "--seed",
          "{seed}",
          "--sampling-method",
          "euler",
          "--rng",
          "cpu",
          "--output",
          "{out}/result.avi",
          "--video-frames",
          "{frames}",
          "--fps",
          "16"
        ],
        [
          "ffmpeg",
          "-v",
          "error",
          "-y",
          "-i",
          "{out}/result.avi",
          "-c:v",
          "libx264",
          "-pix_fmt",
          "yuv420p",
          "-c:a",
          "aac",
          "-movflags",
          "+faststart",
          "{out}/result.mp4"
        ]
      ],
      "outputs": [
        "result.mp4"
      ]
    },
    "image_to_video": {
      "commands": [
        [
          "{repo}/build/bin/sd-cli",
          "--backend",
          "metal",
          "-M",
          "vid_gen",
          "--diffusion-model",
          "{model}/transformer/diffusion_pytorch_model.safetensors",
          "--vae",
          "{vae}/split_files/vae/wan_2.1_vae.safetensors",
          "--llm",
          "{encoder}/Qwen3VL-4B-Instruct-Q4_K_M.gguf",
          "--prompt",
          "{prompt}",
          "--width",
          "{width}",
          "--height",
          "{height}",
          "--steps",
          "{steps}",
          "--cfg-scale",
          "{guidance}",
          "--seed",
          "{seed}",
          "--sampling-method",
          "euler",
          "--rng",
          "cpu",
          "--output",
          "{out}/result.avi",
          "--video-frames",
          "{frames}",
          "--fps",
          "16",
          "-i",
          "{image}"
        ],
        [
          "ffmpeg",
          "-v",
          "error",
          "-y",
          "-i",
          "{out}/result.avi",
          "-c:v",
          "libx264",
          "-pix_fmt",
          "yuv420p",
          "-c:a",
          "aac",
          "-movflags",
          "+faststart",
          "{out}/result.mp4"
        ]
      ],
      "outputs": [
        "result.mp4"
      ]
    }
  }
}
